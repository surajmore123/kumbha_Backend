# Guru AI settings (copy the ones you need into envs/.env.local).
# Placeholders only — never commit real values.

# Provider
GEMINI_API_KEY=<your-gemini-api-key>
AI_CHAT_MODEL=gemini-2.5-flash          # or GEMINI_MODEL (takes precedence)
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=30                   # per model call
AI_MAX_RETRIES=1
AI_REQUEST_BUDGET_SECONDS=90            # all model calls for one message
GEMINI_EMBEDDING_MODEL=gemini-embedding-001   # must match the 3072-dim collection

# Media pipeline: native (Django + Gemini) or n8n (legacy fallback)
AI_MEDIA_PIPELINE=native
N8N_WEBHOOK_URL=<only-if-AI_MEDIA_PIPELINE=n8n>

# Rate limit for chat-send, per user (DRF throttle format)
AI_CHAT_RATE=20/min

# Uploads
AI_MAX_IMAGE_MB=8
AI_MAX_IMAGE_PIXELS=40000000
AI_MAX_IMAGE_SIDE=3072
AI_MAX_AUDIO_MB=15
AI_MAX_AUDIO_SECONDS=180
AI_MAX_DOCUMENT_MB=10
AI_MAX_DOCUMENT_PAGES=50
AI_MAX_EXTRACTED_CHARS=300000
AI_MAX_SHEET_ROWS=2000
AI_DOCUMENT_EXTRACT_SECONDS=20
AI_DOCUMENT_CONTEXT_CHARS=12000
AI_MAX_DOCUMENT_CHUNKS=8
AI_DOCUMENT_OCR_ENABLED=true            # scanned PDFs read by Gemini
AI_OCR_MAX_PAGES=10
FFMPEG_PATH=<optional, e.g. C:\ffmpeg\bin\ffmpeg.exe>
FFPROBE_PATH=<optional>

# Conversation context
AI_HISTORY_MAX_MESSAGES=8
AI_HISTORY_MAX_CHARS=4000

# Knowledge base and live data
QDRANT_LOCAL_PATH=./data/qdrant
AI_RAG_MIN_SCORE=0.60
AI_RAG_EXCLUDED_SOURCE_PREFIXES=local-test/
AI_CROWD_STALE_MINUTES=15

# Optional spoken replies
AI_VOICE_REPLY_ENABLED=false
AI_TTS_MODEL=gemini-2.5-flash-preview-tts
AI_TTS_VOICE=Kore
AI_VOICE_REPLY_MAX_CHARS=1500
